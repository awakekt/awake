#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# 1. Verify Agent & Skills Synchronization
if [[ "${AWAKE_SKIP_AGENT_SYNC_HOOK:-}" != "1" ]]; then
  python3 tools/verify_agent_skills_sync.py
fi

# 2. Check Kotlin & Build Quality Gates (Detekt)
run_detekt=1
if [[ "${AWAKE_SKIP_DETEKT_HOOK:-}" == "1" || "${SKIP_DETEKT_HOOK:-}" == "1" ]]; then
  echo "Skipping Detekt pre-push hook because AWAKE_SKIP_DETEKT_HOOK/SKIP_DETEKT_HOOK is set." >&2
  run_detekt=0
fi

zero_oid="0000000000000000000000000000000000000000"
should_run=0

quality_paths=(
  ":(glob)**/*.kt"
  ":(glob)**/*.kts"
  "build-logic/**"
  "config/detekt/**"
  "gradle/libs.versions.toml"
  ".github/workflows/**"
  # A dump edited by hand rather than regenerated is the one API drift a `.kt` change does not
  # imply, and it is the kind that looks deliberate in review.
  ":(glob)**/api/**/*.api"
)

while read -r local_ref local_oid remote_ref remote_oid; do
  if [[ -z "${local_ref:-}" ]]; then
    continue
  fi

  if [[ "$local_oid" == "$zero_oid" ]]; then
    continue
  fi

  if [[ "$remote_oid" == "$zero_oid" ]]; then
    should_run=1
    break
  fi

  if git diff --name-only "$remote_oid..$local_oid" -- "${quality_paths[@]}" | grep -q .; then
    should_run=1
    break
  fi
done

if [[ "$should_run" != "1" ]]; then
  echo "Pre-push hooks: no Kotlin/build quality changes detected; skipping." >&2
  exit 0
fi

if [[ "$run_detekt" == "1" ]]; then
  echo "Detekt pre-push hook: running ./gradlew detekt" >&2
  echo "Set AWAKE_SKIP_DETEKT_HOOK=1 only for an explicit, reviewed emergency bypass." >&2
  ./gradlew detekt
fi

# 2b. Public API surface
#
# `apiCheck` is a release gate: the publish workflow's `verify` job runs it before anything is
# uploaded. Nothing ran it before a commit, so the dumps drifted every time an ordinary change
# touched a public signature -- six re-dumps in one day, each discovered at push or release time by
# whoever happened to be there rather than by whoever caused it.
#
# `desktopApiCheck`, not `apiCheck`. The aggregate pulls iOS cinterop into its task graph, which
# needs the MoltenVK and JoltC submodules checked out *and built*; on a machine without them it
# fails on a missing header having compared no API at all. The desktop dumps are what
# `api/desktop/*.api` actually holds, so this checks exactly what is committed.
#
# `--continue` because the first failing module is rarely the only one, and a dev who fixes one at a
# time pays the whole Gradle start-up each round.
# Its own flag, not detekt's: they fail for unrelated reasons, and someone bypassing a style rule
# in an emergency should not also stop checking whether they changed the published surface.
if [[ "${AWAKE_SKIP_API_HOOK:-}" == "1" ]]; then
  echo "Skipping the API surface check because AWAKE_SKIP_API_HOOK is set." >&2
else
  echo "API pre-push hook: running ./gradlew desktopApiCheck" >&2
  if ! ./gradlew desktopApiCheck --continue; then
    echo >&2
    echo "The committed API dumps no longer match the code. Regenerate and commit them:" >&2
    echo "  ./gradlew desktopApiDump" >&2
    echo >&2
    echo "Review the diff before committing -- a removal is a breaking change, not a re-dump." >&2
    exit 1
  fi
fi

# 3. Cost and appearance ratchets
#
# Counts and pixels, not milliseconds: how much geometry one frame of ordinary UI produces and how
# many draw runs it coalesces into, plus whether the components still rasterise to their committed
# baselines. Their fixtures are their own rather than an app's, so only an engine change moves them.
# Every number is an exact integer and the rasteriser is deterministic, so neither can flake the way
# a wall-clock threshold would on a loaded dev machine -- which is why RendererHeadlessFrameTimingTest
# refuses to assert on time at all.
#
# The whole module's desktopTest rather than a list of test-name filters: a filter list silently
# stops covering whatever is added next, and this hook is the only thing that runs these.
#
# It lives here rather than in pre-commit because it needs Gradle: pre-commit is deliberately all
# sub-second greps, and making every commit pay a test run would just get the hook disabled.
if [[ "${AWAKE_SKIP_PERF_HOOK:-}" == "1" ]]; then
  echo "Skipping cost/appearance ratchets because AWAKE_SKIP_PERF_HOOK is set." >&2
  exit 0
fi

echo "Cost and appearance ratchets: running :awake:ui:shadcn:desktopTest" >&2
./gradlew :awake:ui:shadcn:desktopTest
