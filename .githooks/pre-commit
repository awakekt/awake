set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

# 1. Verify Copyright & SPDX headers across every tracked file (if tool exists)
#
# --all, not --staged: the narrow check let an unheadered file sit indefinitely and then fail
# whichever unrelated change next touched it, which is how 32 of them accumulated. The whole-repo
# scan takes well under a second and fails at the point a gap appears.
if [ -f "$repo_root/tools/verify_copyright_headers.py" ]; then
  if ! python3 "$repo_root/tools/verify_copyright_headers.py" --all; then
    echo "pre-commit hook: first-party source is missing the required copyright/SPDX header." >&2
    echo "This scans every tracked file, so the offender may not be one you edited." >&2
    exit 1
  fi
fi

# 1b. Dependency snippets in the docs must resolve.
#
# Whole-repo like the header scan above, and for the same reason: a stale snippet is not noticed
# by the commit that staled it -- renaming an artifact leaves the README wrong without touching it.
# Four of the four snippets in the repo were unresolvable when this gate was added.
if [ -f "$repo_root/tools/verify_doc_coordinates.py" ]; then
  if ! python3 "$repo_root/tools/verify_doc_coordinates.py"; then
    echo "pre-commit hook: a doc advertises Maven coordinates no consumer could resolve." >&2
    exit 1
  fi
fi

# 2. Secret & Token Scanner (gitleaks)
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --pre-commit --redact --staged --no-banner; then
    echo "pre-commit hook: gitleaks found a likely secret in staged changes." >&2
    echo "Remove it, or add a verified false positive to .gitleaks.toml." >&2
    exit 1
  fi
fi

# 3. Large Binary File Guard (> 15MB check)
max_bytes=15728640
large_files=$(git diff --cached --name-only | while read -r f; do
  if [ -f "$f" ]; then
    size=$(wc -c < "$f" | tr -d ' ')
    if [ "$size" -gt "$max_bytes" ]; then
      echo "$f ($(( size / 1048576 ))MB)"
    fi
  fi
done)

if [ -n "$large_files" ]; then
  echo "pre-commit hook: staged file exceeds 15MB size limit (use Git LFS or external assets):" >&2
  echo "$large_files" >&2
  exit 1
fi

# 4. Lesson Harvesting Reminder
if git diff --cached --name-only | grep -q "^docs/lessons/"; then
  echo "💡 [kmp-agent-skills] New lesson staged! Run '/kmp-harvest-lessons' when ready to upstream patterns."
fi

# 5. Tech Debt & Orphan Comment Guard (checks newly added TODOs)
raw_todos=$(git diff --cached -U0 | grep -E '^\+\s*//\s*(TODO|FIXME)' | grep -vE '#[0-9]+|\([A-Za-z0-9_-]+-[0-9]+\)' || true)
if [ -n "$raw_todos" ]; then
  echo "💡 [tech-debt] Staged untracked TODO without ticket reference (e.g. // TODO(#123): ...):"
  echo "$raw_todos" | head -n 3 | sed 's/^+/  /'
  echo "  Tip: Link to an issue or park in docs/audits/ to prevent tech debt drift."
fi

# 6. Self-Healing Docs Sitemap (if docs/ was modified)
if git diff --cached --name-only | grep -q "^docs/.*\.md$"; then
  if [ -f "$repo_root/scripts/heal_docs.py" ]; then
    python3 "$repo_root/scripts/heal_docs.py" --project "$repo_root" >/dev/null 2>&1 || true
    if [ -f "$repo_root/docs/README.md" ]; then
      git add "$repo_root/docs/README.md"
    fi
  fi
fi

# 7. Lightweight Architecture Smell Scan (if hook script exists)
if [ -f "$repo_root/hooks/pre-commit-audit.sh" ]; then
  exec "$repo_root/hooks/pre-commit-audit.sh"
fi

