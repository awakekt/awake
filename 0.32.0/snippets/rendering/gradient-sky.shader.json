{
  "formatVersion": 1,
  "name": "Gradient sky",
  "surface": "background",
  "parameters": [
    { "name": "top", "type": "color", "default": [0.1, 0.3, 0.8, 1] },
    { "name": "bottom", "type": "color", "default": [0.9, 0.5, 0.3, 1] }
  ],
  "fragment": {
    "color": { "op": "call", "fn": "mix", "args": [
      { "op": "param", "name": "bottom" },
      { "op": "param", "name": "top" },
      { "op": "call", "fn": "saturate", "args": [
        { "op": "swizzle", "value": { "op": "input", "input": "viewDirection" }, "components": "y" }
      ] }
    ] }
  }
}
