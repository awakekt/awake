# Copyright (c) Ron June Valdoz
# SPDX-License-Identifier: Apache-2.0
#
# Entry point for Awake developer tooling. Add this directory to PATH to use `awake ...`.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
command="${1:-}"
shift || true
case "$command" in
  verify)
    exec "$REPO_ROOT/gradlew" awakeVerify "$@"
    ;;
  release)
    exec "$REPO_ROOT/gradlew" releaseCut "$@"
    ;;
  ui)
    exec python3 "$REPO_ROOT/tools/shadcn/awake_ui.py" "$@"
    ;;
  *)
    echo "Usage: scripts/awake {verify|release|ui} [options]" >&2
    exit 2
    ;;
esac
